# Keep secrets and local state out of the build context. Anything listed here
# would otherwise be copied into an image layer by "COPY . .".
.env
.env.*
!.env.example
cookies.txt
config.yaml

# Local database and backups
data/
*.db
*.db-shm
*.db-wal

# Build output
*.exe
*.test
*.test.exe
schedlock
dist/
build/

# Version control and tooling
.git/
.github/
.gitignore
.claude/
.idea/
.vscode/

# Documentation not needed to build
design_doc.md
*.md
!README.md
